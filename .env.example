# Copiá este archivo a .env si querés personalizar el frontend.
# La API se consume con rutas relativas al mismo origen (nginx reenvía /api/
# al backend), por lo que por defecto NO hace falta definir nada acá.
# Definí VITE_API_URL solo si el frontend consume una API en otro origen.
# Las variables con prefijo VITE_ se exponen en el bundle del cliente,
# por lo que nunca deben contener secretos.
# VITE_API_URL=/api
